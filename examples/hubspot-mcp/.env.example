# Local configuration. notebooks/10_hubspot_mcp.ipynb writes .env from this file.
# No secrets here: the client secret is read from Secret Manager.

GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west3

# Your MCP auth app in HubSpot (Development > MCP Auth Apps)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET_NAME=hubspot-mcp-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/dev-ui/

# https://mcp-eu1.hubspot.com for EU-hosted HubSpot accounts
HUBSPOT_MCP_URL=https://mcp.hubspot.com
HUBSPOT_AUTHORIZATION_URL=https://mcp.hubspot.com/oauth/authorize/user
HUBSPOT_TOKEN_URL=https://mcp.hubspot.com/oauth/v3/token
